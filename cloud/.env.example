# HBI Microservices configuration.
#
#   cp .env.example .env
#
# Then edit .env and set a real JWT_SECRET. Never commit .env.

# --- authentication ---------------------------------------------------------
# HMAC-SHA256 signing key. Must be at least 32 characters; the services refuse
# to start otherwise. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_MINUTES=720

# --- databases --------------------------------------------------------------
# Each service gets its own database; these credentials apply to every
# Postgres instance in docker-compose.
DATABASE_USERNAME=hbi
DATABASE_PASSWORD=hbi

# Set per service when running outside Docker, e.g.
#   DATABASE_URL=jdbc:postgresql://localhost:5433/user_db
# In Docker each service already has the right value injected.

# --- kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_RATINGS_TOPIC=hbi.ratings
KAFKA_ROOM_EVENTS_TOPIC=hbi.room-events
KAFKA_GROUP_ID=hbi-rating-service

# --- rate limiting ----------------------------------------------------------
# Anonymous session creation (POST /api/users/session) is throttled per caller
# at the gateway: a burst of SESSION_RATE_CAPACITY, refilling at
# SESSION_RATE_REFILL_PER_MINUTE. Defaults are generous for local development
# and the test suites; consider something like 10/10 for a public deployment.
SESSION_RATE_CAPACITY=60
SESSION_RATE_REFILL_PER_MINUTE=60

# --- application ------------------------------------------------------------
# How many food items a room rates at most in one blend. Players may finish
# early once they have rated half of them (rounded up).
BLEND_SHORTLIST_SIZE=12

# Rooms with no activity (join/leave/status change/rating) for this long are
# garbage-collected together with their members and rating data. The sweep
# runs every CLEANUP_INTERVAL_MS.
ROOM_TTL_HOURS=24
CLEANUP_INTERVAL_MS=3600000

# Origins allowed to call the gateway cross-origin. Same-origin traffic (the
# Dockerised frontend proxying /api and /ws, whatever host it is browsed on —
# localhost or a LAN IP) needs no entry here. Add origins only for genuinely
# cross-origin setups, e.g. `npm run dev` on :5173 talking to the gateway
# directly, or a browser pointed at a dev server on another machine:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,http://10.125.61.42:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
